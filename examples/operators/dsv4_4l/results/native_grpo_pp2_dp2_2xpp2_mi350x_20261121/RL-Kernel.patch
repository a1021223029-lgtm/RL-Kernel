+# SPDX-License-Identifier: Apache-2.0
+"""CPU checks of the launch plan and DP evidence validation, without a GPU job."""
+
+import copy
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from examples.operators.dsv4_4l.verify_grpo import verify_dp_step
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+@pytest.mark.parametrize("gpus", [4, 8])
+def test_dry_run_does_not_require_devices_or_create_output(tmp_path, gpus):
+    output = tmp_path / "not-created"
+    result = subprocess.run(
+        [
+            sys.executable,
+            str(ROOT / "examples/operators/dsv4_4l/run_grpo.py"),
+            "review-image",
+            "missing-checkpoint",
+            "missing-data",
+            str(output),
+            "missing-cache",
+            "--num-gpus",
+            str(gpus),
+            "--dry-run",
+        ],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    plan = json.loads(result.stdout)
+    assert not output.exists()
+    assert len(plan["actor_physical_gpus"]) == len(plan["rollout_physical_gpus"]) == gpus // 2
+    assert len(set(plan["actor_physical_gpus"] + plan["rollout_physical_gpus"])) == gpus
+    command = plan["command"]
+    assert "data.train_batch_size=2" in command and "actor_rollout_ref.rollout.n=2" in command
+    assert f"+ray_kwargs.ray_init.num_gpus={gpus}" in command
+    if gpus == 8:
+        assert "+recipe=dsv4_grpo_8gpu" in command
+        assert "rlk.audit_response_length=16" in command
+        assert plan["actor_physical_gpus"] == [0, 1, 2, 3]
+    else:
+        assert plan["config_name"] == "dsv4_grpo"
+        assert "rlk.audit_response_length=3" in command
+        assert plan["actor_physical_gpus"] == [4, 5]
+
+
+def dp_records():
+    identities, ranks = {}, []
+    for rank in range(4):
+        identities[rank] = dict(dp_rank=rank % 2, pipeline_stage=rank // 2)
+        tensor = dict(sha256=f"stage-{rank // 2}", finite=True)
+        optimizer = dict(
+            state_tensors={"moment": dict(tensor, data_ptr=rank)}, state_scalars={"step": 1}
+        )
+        ranks.append(
+            dict(
+                rank=rank,
+                **identities[rank],
+                parameter_before={"p": "old"},
+                parameter_after={"p": "new"},
+                gradient_records={"p": tensor},
+                optimizer_before=optimizer,
+                optimizer_after=optimizer,
+                ddp_evidence=dict(
+                    dp_replicas=2,
+                    native_ddp_finish_calls=["native"],
+                    different_local_gradients=True,
+                    reduced_gradients={"p": tensor},
+                    missing_mhc_backward_parameters=[],
+                ),
+            )
+        )
+    return ranks, identities
+
+
+def test_dp_state_checks_compare_hashes_and_ignore_process_pointers():
+    verify_dp_step(*dp_records(), 2)
+
+
+@pytest.mark.parametrize(
+    "corruption", ["parameter", "gradient", "optimizer", "no_reduce", "same_local", "missing_rank"]
+)
+def test_bad_dp_evidence_is_rejected(corruption):
+    ranks, identities = copy.deepcopy(dp_records())
+    if corruption == "parameter":
+        ranks[1]["parameter_after"]["p"] = "bad"
+    elif corruption == "gradient":
+        ranks[1]["ddp_evidence"]["reduced_gradients"]["p"]["sha256"] = "bad"
+    elif corruption == "optimizer":
+        ranks[1]["optimizer_after"]["state_scalars"]["step"] = 2
+    elif corruption == "no_reduce":
+        ranks[1]["ddp_evidence"]["native_ddp_finish_calls"] = []
+    elif corruption == "same_local":
+        ranks[1]["ddp_evidence"]["different_local_gradients"] = False
+    else:
+        ranks.pop()
+    with pytest.raises(AssertionError):
+        verify_dp_step(ranks, identities, 2)
+
+
+def test_dp_observer_preserves_optional_backward_gradients():
+    torch = pytest.importorskip("torch")
+    from types import SimpleNamespace
+
+    from examples.operators.dsv4_4l.distributed_evidence import ddp_step_evidence
+
+    class OptionalInput(torch.autograd.Function):
+        @staticmethod
+        def forward(ctx, active, unused):
+            ctx.set_materialize_grads(False)
+            return active * 2
+
+        @staticmethod
+        def backward(ctx, gradient):
+            return gradient * 2, None
+
+    model = torch.nn.Module()
+    model.active = torch.nn.Parameter(torch.tensor(3.0))
+    model.unused = torch.nn.Parameter(torch.tensor(5.0))
+    engine = SimpleNamespace(module=[], optimizer_step=lambda: None)
+    original_step = engine.optimizer_step
+    with ddp_step_evidence(engine, model) as evidence:
+        OptionalInput.apply(model.active, model.unused).backward()
+    assert torch.equal(model.active.grad, torch.tensor(2.0))
+    assert model.unused.grad is None
+    assert set(evidence["local_gradients"]) == {"active"}
+    assert evidence["local_gradients"]["active"]["finite"]
+    assert evidence["local_gradients"]["active"]["nonzero"]
+    assert engine.optimizer_step is original_step
