+# SPDX-License-Identifier: Apache-2.0
+import asyncio
+import copy
+import importlib.util
+import json
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[3] / "verl/experimental/rl_kernel"
+PACKAGE = "_rlk_eight_gpu_tests"
+package = types.ModuleType(PACKAGE)
+package.__path__ = [str(ROOT)]
+sys.modules[PACKAGE] = package
+
+
+def load(name):
+    spec = importlib.util.spec_from_file_location(f"{PACKAGE}.{name}", ROOT / f"{name}.py")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+cluster = load("cluster_contract")
+contract = load("trainer_contract")
+sync_module = load("trainer_sync")
+
+
+def config(gpus=4):
+    return dict(
+        rlk={},
+        trainer=dict(nnodes=1, n_gpus_per_node=gpus),
+        actor_rollout_ref=dict(rollout=dict(nnodes=1, n_gpus_per_node=gpus)),
+    )
+
+
+def exports(version=0):
+    return [
+        dict(
+            rank=rank,
+            dp_rank=rank // 2,
+            pipeline_stage=rank % 2,
+            weight_version=version,
+            manifest={"a": dict(sha256="abc", dtype="torch.float32", shape=[1])},
+        )
+        for rank in range(4)
+    ]
+
+
+def test_eight_gpu_layout_and_placement():
+    plan = cluster.topology(config())
+    assert (plan["actor_world_size"], plan["actor_dp_size"], plan["rollout_replicas"]) == (4, 2, 2)
+    actors = [dict(rank=i, node_id="node", pci_bus_id=f"gpu{i}") for i in range(4)]
+    rollouts = [dict(rank=i % 2, replica_rank=i // 2, node_id="node", pci_bus_id=f"gpu{i + 4}") for i in range(4)]
+    cluster.verify_placement(plan, actors, rollouts, {"node": "10.0.0.1"})
+    rollouts[-1]["replica_rank"] = 0
+    with pytest.raises(RuntimeError, match="missing or duplicate"):
+        cluster.verify_placement(plan, actors, rollouts, {"node": "10.0.0.1"})
+
+
+@pytest.mark.parametrize("side", ["actor", "rollout"])
+def test_mixed_or_multinode_eight_gpu_layout_fails(side):
+    c = config()
+    settings = c["trainer"] if side == "actor" else c["actor_rollout_ref"]["rollout"]
+    settings["n_gpus_per_node"] = 2
+    with pytest.raises(ValueError):
+        cluster.topology(c)
+    c = config()
+    c["rlk"]["multinode"] = True
+    with pytest.raises(ValueError):
+        cluster.topology(c)
+
+
+@pytest.mark.parametrize("failure", ["missing", "duplicate", "version", "manifest", "coordinate"])
+def test_actor_export_requires_every_rank_and_identical_policy(failure):
+    rows = exports()
+    contract.validate_actor_exports(rows, 4, 0)
+    if failure == "missing":
+        rows.pop()
+    elif failure == "duplicate":
+        rows[-1]["rank"] = 0
+    elif failure == "version":
+        rows[-1]["weight_version"] = 1
+    elif failure == "manifest":
+        rows[-1]["manifest"] = {}
+    else:
+        rows[-1]["dp_rank"] = 0
+    with pytest.raises(RuntimeError):
+        contract.validate_actor_exports(rows, 4, 0)
+
+
+def test_actor_audit_covers_both_dp_outputs():
+    rows = [None, dict(dp_rank=1, weight_version=2), None, dict(dp_rank=0, weight_version=2)]
+    assert [r["dp_rank"] for r in contract.select_actor_scores(rows, 2, 2)] == [0, 1]
+    for bad in (rows[:-1], [rows[1], rows[1]]):
+        with pytest.raises(RuntimeError):
+            contract.select_actor_scores(bad, 2, 2)
+
