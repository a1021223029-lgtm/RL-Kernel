+def test_hydra_eight_gpu_recipe_keeps_accepted_workload(tmp_path):
+    from hydra import compose, initialize_config_dir
+
+    search = (ROOT.parents[1] / "trainer/config").as_posix()
+    with initialize_config_dir(config_dir=str(ROOT / "config"), version_base=None):
+        c = compose(
+            config_name="dsv4_grpo",
+            overrides=[
+                "+recipe=dsv4_grpo_8gpu",
+                f"hydra.searchpath=[file://{search}]",
+                f"rlk.sync_dir={tmp_path.as_posix()}",
+                "actor_rollout_ref.model.path=/models/4l",
+                "data.train_files=/data/train.parquet",
+                "data.val_files=/data/val.parquet",
+            ],
+        )
+    contract.validate_trainer_config(c)
+    assert cluster.topology(c)["actor_dp_size"] == 2
+    assert c.actor_rollout_ref.rollout.data_parallel_size == 1
+    assert c.data.train_batch_size == c.actor_rollout_ref.actor.ppo_mini_batch_size == 2
+    assert c.actor_rollout_ref.rollout.n == 2 and c.trainer.total_training_steps == 3
+    assert c.data.max_prompt_length == 128 and c.data.max_response_length == 16
+    r = c.actor_rollout_ref.rollout
+    assert (r.max_model_len, r.max_num_batched_tokens, r.max_num_seqs) == (256, 512, 8)
+    assert (r.temperature, r.top_p, r.top_k, r.seed) == (1.0, 1.0, -1, 42)
+    assert c.actor_rollout_ref.actor.optim.lr == 1e-6
+
+
+class Remote:
+    def __init__(self, function):
+        self.remote = function
+
+
+class Server:
+    def __init__(self, replica, events, *, fail=False):
+        self.replica = replica
+        self.events = events
+        self.fail = fail
+        self.abort_all_requests = Remote(self.abort)
+        self.rlk_load_policy = Remote(self.load)
+        self.resume_generation = Remote(self.resume)
+
+    async def abort(self, **kwargs):
+        self.events.append(("abort", self.replica))
+
+    async def load(self, path, version):
+        self.events.append(("load", self.replica))
+        if self.fail:
+            raise RuntimeError("injected load failure")
+        return [
+            dict(
+                pipeline_stage=p,
+                pid=100 + 2 * self.replica + p,
+                weight_version=version,
+                parameter_load_completed=True,
+                verified_original_tensors=exports()[0]["manifest"]
+                if p == 0
+                else {"b": dict(sha256="def", dtype="torch.float32", shape=[1])},
+            )
+            for p in (0, 1)
+        ]
+
+    async def resume(self):
+        self.events.append(("resume", self.replica))
+
+
+@pytest.mark.parametrize("fail", [False, True])
+def test_two_replica_sync_barrier_and_failure_keeps_admission_closed(tmp_path, fail):
+    events = []
+    rows = exports()
+    for row in rows:
+        row["manifest"]["b"] = dict(sha256="def", dtype="torch.float32", shape=[1])
+
+    def export(path):
+        Path(path).write_text("policy")
+        events.append(("export", 0))
+        return copy.deepcopy(rows)
+
+    actor = types.SimpleNamespace(rlk_export_policy=export)
+    servers = [Server(i, events, fail=fail and i == 1) for i in range(2)]
+    sync = sync_module.RLKPolicySync(actor, servers, str(tmp_path), actor_world_size=4, rollout_replicas=2)
+    if fail:
+        with pytest.raises(RuntimeError, match="injected"):
+            asyncio.run(sync.update(0))
+        assert not any(e[0] == "resume" for e in events)
+        assert sync.version is None
+        assert not (tmp_path / "sync-v0.json").exists()
+    else:
+        asyncio.run(sync.update(0))
+        assert len(sync.replica_pids) == 2 and sync.version == 0
+        assert events.index(("export", 0)) > max(events.index(("abort", i)) for i in range(2))
+        assert min(events.index(("resume", i)) for i in range(2)) > max(events.index(("load", i)) for i in range(2))
+        record = json.loads((tmp_path / "sync-v0-raw.json").read_text())
+        assert {r["replica_rank"] for r in record["replicas"]} == {0, 1}
+        assert len(record["actor_exports"]) == 4
+
