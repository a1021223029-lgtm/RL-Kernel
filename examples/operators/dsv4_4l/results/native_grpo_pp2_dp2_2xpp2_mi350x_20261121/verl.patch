+@pytest.mark.parametrize("corrupt_dp", [False, True])
+def test_live_audit_checks_each_rollout_and_actor_dp(tmp_path, monkeypatch, corrupt_dp):
+    import torch
+
+    audit = load("acceptance")
+    monkeypatch.setitem(sys.modules, "ray", types.SimpleNamespace(get=lambda value: value))
+
+    def score(cases, version, micro, *trace):
+        replies = []
+        for dp in range(2):
+            scores = [torch.full((len(case["response_ids"]),), -1.0) for case in cases]
+            if corrupt_dp and dp == 1:
+                scores[0].view(torch.int32)[0] ^= 1
+            length = max(len(c["prompt_ids"]) + len(c["response_ids"]) for c in cases)
+            tokens = [
+                c["prompt_ids"] + c["response_ids"] + [0] * (length - len(c["prompt_ids"]) - len(c["response_ids"]))
+                for c in cases
+            ]
+            replies.append(
+                dict(
+                    dp_rank=dp,
+                    weight_version=version,
+                    scores=scores,
+                    forward_batches=[dict(shape=[len(cases), length], tokens=tokens)],
+                )
+            )
+        return replies
+
+    class AuditServer:
+        def __init__(self, replica):
+            self.replica = replica
+            self.requests = 0
+            self.generate = Remote(self.fresh)
+            self.rlk_score_sequences = Remote(self.score)
+
+        async def fresh(self, **kwargs):
+            self.requests += 1
+            return types.SimpleNamespace(
+                token_ids=[7 + self.replica, 8], log_probs=[-1.0, -1.0], extra_fields=dict(global_steps=0)
+            )
+
+        def score(self, cases, label):
+            return dict(global_steps=0, scores=[[-1.0] * len(c["response_ids"]) for c in cases], stages=[])
+
+    c = config()
+    c["rlk"].update(sync_dir=str(tmp_path), audit_prompts=["AAA", "BB", "C"], audit_response_length=16)
+    from omegaconf import OmegaConf
+
+    servers = [AuditServer(i) for i in range(2)]
+    trainer = types.SimpleNamespace(
+        config=OmegaConf.create(c),
+        checkpoint_manager=types.SimpleNamespace(version=0),
+        global_steps=0,
+        tokenizer=types.SimpleNamespace(encode=lambda p, **kwargs: [1] * len(p)),
+        actor_rollout_wg=types.SimpleNamespace(rlk_score_sequences=score),
+        llm_server_manager=types.SimpleNamespace(server_handles=servers),
+    )
+    if corrupt_dp:
+        with pytest.raises(RuntimeError, match="raw logprob mismatch"):
+            audit.audit_version(trainer)
+        assert not (tmp_path / "initial-v0.json").exists()
+        assert list((tmp_path / "replica-0").glob("audit-v0-*.pt"))
+    else:
+        result = audit.audit_version(trainer)
+        assert [s.requests for s in servers] == [3, 3]
+        assert {r["replica_rank"] for r in result["replicas"]} == {0, 1}
+        for i in range(2):
+            record = json.loads((tmp_path / f"replica-{i}/initial-v0.json").read_text())
+            assert record["actor_dp_size"] == 2
+            raw = torch.load(tmp_path / f"replica-{i}" / record["rows"][0]["evidence_file"], weights_only=True)
+            assert raw["actor_dp_ranks"] == [0, 1] and raw["replica_rank"] == i
