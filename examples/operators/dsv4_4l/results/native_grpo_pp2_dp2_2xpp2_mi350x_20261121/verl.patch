+def test_bad_second_replica_readback_never_resumes(tmp_path):
+    events = []
+    rows = exports()
+    for row in rows:
+        row["manifest"]["b"] = dict(sha256="def", dtype="torch.float32", shape=[1])
+    actor = types.SimpleNamespace(rlk_export_policy=lambda path: rows)
+    servers = [Server(i, events) for i in range(2)]
+
+    async def corrupted(path, version):
+        acks = await servers[1].load(path, version)
+        acks[1]["verified_original_tensors"]["b"]["sha256"] = "bad"
+        return acks
+
+    servers[1].rlk_load_policy = Remote(corrupted)
+    sync = sync_module.RLKPolicySync(actor, servers, str(tmp_path), actor_world_size=4, rollout_replicas=2)
+    with pytest.raises(RuntimeError, match="complete actor state"):
+        asyncio.run(sync.update(0))
+    assert not any(e[0] == "resume" for e in events)
+    assert sync.version is None
+
+
+def test_continuous_v0_to_v3_sync_and_worker_restart_rejection(tmp_path):
+    events = []
+    version = 0
+
+    def export(path):
+        Path(path).write_text("policy")
+        rows = exports(version)
+        for row in rows:
+            row["manifest"]["b"] = dict(sha256="def", dtype="torch.float32", shape=[1])
+        return rows
+
+    servers = [Server(i, events) for i in range(2)]
+    actor = types.SimpleNamespace(rlk_export_policy=export)
+    sync = sync_module.RLKPolicySync(actor, servers, str(tmp_path), actor_world_size=4, rollout_replicas=2)
+    for version in range(4):
+        asyncio.run(sync.update(version))
+        assert sync.version == version
+    assert len(list(tmp_path.glob("sync-v[0-3].json"))) == 4
+    assert all((tmp_path / f"policy-v{i}.pt").exists() for i in range(1, 4))
+    version = 4
+    servers[1].replica = 5
+    before = len([e for e in events if e[0] == "resume"])
+    with pytest.raises(RuntimeError, match="PIDs changed"):
+        asyncio.run(sync.update(version))
+    assert sync.version == 3
+    assert len([e for e in events if e[0] == "resume"]) == before
+
